DATABASE_URL="postgresql://usuario:password@localhost:5432/gestock?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-seguro"
JWT_EXPIRES_IN="8h"
PORT=3000

# URL base del frontend/backend para armar el link de recuperacion de clave
APP_URL="http://localhost:5173"

# --- Correo (recuperacion de clave) ---
# Opcion A: Gmail -> usa una "contrasena de aplicacion" (no tu clave normal),
#   se genera en https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 | SMTP_SECURE=false
# Opcion B: Mailtrap (pruebas, no envia correos reales, solo los atrapa)
#   SMTP_HOST=sandbox.smtp.mailtrap.io | SMTP_PORT=2525
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="\"Gestock\" <no-reply@gestock.com>"
